# Example secrets file - DO NOT commit with real values
# Create actual secrets with: kubectl create secret generic <name> --from-literal=<key>=<value>

apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  labels:
    app: ocelot-tracker
type: Opaque
stringData:
  username: tracker
  password: CHANGE_ME_IN_PRODUCTION

---
apiVersion: v1
kind: Secret
metadata:
  name: ocelot-secrets
  labels:
    app: ocelot-tracker
type: Opaque
stringData:
  jwt-secret: CHANGE_ME_TO_RANDOM_256BIT_KEY
  site-password: CHANGE_ME_IN_PRODUCTION
